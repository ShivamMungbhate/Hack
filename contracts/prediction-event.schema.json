
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignBridge Prediction Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "timestamp_ms",
    "sign",
    "confidence",
    "alternatives",
    "gloss_buffer",
    "sentence",
    "is_final"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "type": {
      "const": "sign_prediction"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "sign": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "alternatives": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sign", "confidence"],
        "properties": {
          "sign": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "gloss_buffer": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sentence": {
      "type": ["string", "null"]
    },
    "is_final": {
      "type": "boolean"
    }
  }
}
